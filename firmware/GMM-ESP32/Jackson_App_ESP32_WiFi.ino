/*
  Jackson_App_ESP32_WiFi.ino  |  Jackson Five - NASA Space Apps 2026
  Firmware for the Kayena crop-rotation assistant.

  OVERVIEW
    Same as Jackson_App_ESP32.ino, but it ALSO sends readings over WiFi, so the
    Kayena app on a phone (APK) or laptop can read the ESP32 without a cable.

  WHAT IT DOES
    1. Reads AIR temperature and humidity from a DHT11 sensor every 2 seconds.
    2. Runs the Gaussian Mixture Model (GMM) ON the ESP32 (TinyML), using the
       average of the last 30 seconds. The model (gmm_modelo.h) was trained
       with NASA POWER daily data for Namiquipa, Chihuahua (2016-2023).
    3. Every 10 seconds it sends ONE line, over USB and WiFi, in this format:
         {"t":24.3,"h":31.0,"g":1,"p":[0.12,0.85,0.03]}
       t = temperature (°C), averaged over the last 10 s
       h = relative humidity (%), averaged over the last 10 s
       g = index of the most likely GMM group (season)
       p = probability of each GMM group, in the order defined in gmm_modelo.h
       An optional "f":"manual" field marks values typed in test mode.
       Lines starting with "#" are human-readable messages; the app ignores them.

  WIFI (default, MODO_AP = 1: access-point mode)
    The ESP32 creates its own network. No event WiFi or internet is needed.
      Network (SSID): Kayena-ESP32
      Password:       jackson5
      In the app:     192.168.4.1:3333   (plain TCP, one JSON line per reading)
    On the phone, join "Kayena-ESP32". If Android warns "this network has no
    internet access", choose to stay connected.

    To join a phone hotspot instead (station mode), set MODO_AP to 0 and fill in
    RED_CASA / CLAVE_CASA below. The assigned IP is printed on the Serial Monitor.

  SENSOR: DHT11
    Range 0-50 °C (±2 °C) and 20-90 % RH (±5 %), at most one read per second.
    It cannot measure below 0 °C, so it cannot report how hard a frost was.

  WIRING
    DHT11 data -> GPIO 4, power -> 3.3 V, ground -> GND. Serial at 115200 baud.

  REQUIRED FILES (same folder as this sketch)
    gmm_modelo.h      model parameters generated by entrenar_gmm.py
    gmm_clasificar.h  gmm_clasificar(): GMM inference (Mahalanobis + softmax)

  LIBRARIES
    "DHT sensor library" (Adafruit). WiFi.h comes with the ESP32 board package.

  TEST MODE (no sensor)
    Set USAR_SENSOR to 0 and type "temperature,humidity" in the Serial Monitor
    (e.g. 30,20). Close the Serial Monitor before opening the Kayena app:
    only one program can use the USB port at a time.
*/

#include <WiFi.h>
#include <DHT.h>
#include "gmm_clasificar.h"

// ========================= CONFIGURATION =========================
#define USAR_SENSOR 1          // 1 = real DHT11 | 0 = Serial test mode only
#define PIN_DHT     4          // GPIO connected to the DHT11 data pin
#define TIPO_DHT    DHT11      // sensor model used by the team

#define MODO_AP     1          // 1 = ESP32 creates the network | 0 = joins a network
const char* RED_AP       = "Kayena-ESP32";        // SSID in access-point mode
const char* CLAVE_AP     = "jackson5";            // password (at least 8 characters)
const char* RED_CASA     = "NombreDeTuHotspot";   // SSID to join (only if MODO_AP = 0)
const char* CLAVE_CASA   = "ContraseñaDelHotspot"; // its password
const uint16_t PUERTO_TCP = 3333;                 // TCP port the app connects to

const unsigned long PERIODO_MS = 2000;   // time between reads (DHT11 allows 1 s; 2 s is safe)
const int LECTURAS_POR_ENVIO = 5;        // 5 reads x 2 s = one line every 10 s
const int N_PROMEDIO_GMM = 15;           // 15 reads x 2 s = 30 s average for the GMM
const int MAX_CLIENTES = 3;              // phone + laptop + one spare
// =================================================================

DHT dht(PIN_DHT, TIPO_DHT);
WiFiServer servidor(PUERTO_TCP);         // TCP server the app connects to
WiFiClient clientes[MAX_CLIENTES];       // connected apps

// Ring buffer with the last 30 s of readings (input to the GMM)
float hist_t[N_PROMEDIO_GMM], hist_h[N_PROMEDIO_GMM];
int guardadas = 0, posicion = 0;         // how many are stored / next slot to write

// Running sums for the 10 s average that is sent to the app
float suma_t = 0, suma_h = 0;
int en_envio = 0;

unsigned long ultimo = 0;                // time of the last sensor read (ms)
int errores_seguidos = 0;                // consecutive failed DHT11 reads
String ultimaLinea = "";                 // last JSON line, sent to new clients right away

// Sends one line over USB and to every app connected over WiFi.
void mandarLinea(const String& linea) {
  Serial.println(linea);
  for (int i = 0; i < MAX_CLIENTES; i++) {
    if (clientes[i] && clientes[i].connected()) clientes[i].println(linea);
  }
}

// Accepts new WiFi connections (up to MAX_CLIENTES) and immediately sends
// them the latest reading, so the app does not wait 10 s for its first data.
void atenderClientes() {
  WiFiClient nuevo = servidor.available();
  if (!nuevo) return;
  for (int i = 0; i < MAX_CLIENTES; i++) {
    if (!clientes[i] || !clientes[i].connected()) {   // reuse a free or dead slot
      clientes[i].stop();
      clientes[i] = nuevo;
      clientes[i].println("# Kayena ESP32 over WiFi. One reading every 10 s.");
      if (ultimaLinea.length()) clientes[i].println(ultimaLinea);
      Serial.printf("# App connected from %s\n", nuevo.remoteIP().toString().c_str());
      return;
    }
  }
  nuevo.println("# Too many apps connected.");
  nuevo.stop();
}

// Classifies with the GMM and sends the JSON line.
//   t, h    values to report (10 s average, or values typed in test mode)
//   fuente  nullptr for sensor data, or a tag such as "manual"
// The GMM uses the 30 s average once the buffer is full; until then it uses t, h.
void mandarJSON(float t, float h, const char* fuente) {
  float prob[GMM_N_GRUPOS];
  float tg = t, hg = h;
  if (guardadas >= N_PROMEDIO_GMM) {
    tg = 0; hg = 0;
    for (int i = 0; i < N_PROMEDIO_GMM; i++) { tg += hist_t[i]; hg += hist_h[i]; }
    tg /= N_PROMEDIO_GMM; hg /= N_PROMEDIO_GMM;
  }
  int g = gmm_clasificar(tg, hg, prob);   // TinyML inference on the ESP32

  // Build {"t":..,"h":..,"g":..,"p":[..]} in a fixed buffer (no heap churn)
  char buf[160];
  int n = snprintf(buf, sizeof(buf), "{\"t\":%.2f,\"h\":%.1f,\"g\":%d,\"p\":[", t, h, g);
  for (int i = 0; i < GMM_N_GRUPOS; i++) {
    n += snprintf(buf + n, sizeof(buf) - n, i ? ",%.4f" : "%.4f", prob[i]);
  }
  if (fuente) snprintf(buf + n, sizeof(buf) - n, "],\"f\":\"%s\"}", fuente);
  else snprintf(buf + n, sizeof(buf) - n, "]}");

  ultimaLinea = buf;
  mandarLinea(ultimaLinea);
}

// Test mode: reads "temperature,humidity" typed in the Serial Monitor and
// sends it as a reading tagged "manual". Works even with the sensor enabled.
void revisarModoPrueba() {
  if (!Serial.available()) return;
  String linea = Serial.readStringUntil('\n');
  linea.trim();
  int coma = linea.indexOf(',');
  if (coma < 0) {
    Serial.println("# Type it like this: temperature,humidity   (example: 30,20)");
    return;
  }
  mandarJSON(linea.substring(0, coma).toFloat(), linea.substring(coma + 1).toFloat(), "manual");
}

// Starts WiFi in access-point or station mode and opens the TCP server.
// If station mode cannot connect within ~20 s, USB keeps working.
void arrancarWiFi() {
#if MODO_AP
  WiFi.mode(WIFI_AP);
  WiFi.softAP(RED_AP, CLAVE_AP);
  Serial.printf("# WiFi ready. Network: %s  Password: %s\n", RED_AP, CLAVE_AP);
  Serial.printf("# In the app, type: %s:%u\n", WiFi.softAPIP().toString().c_str(), PUERTO_TCP);
#else
  WiFi.mode(WIFI_STA);
  WiFi.begin(RED_CASA, CLAVE_CASA);
  Serial.print("# Connecting to WiFi");
  for (int i = 0; i < 40 && WiFi.status() != WL_CONNECTED; i++) { delay(500); Serial.print("."); }
  Serial.println();
  if (WiFi.status() == WL_CONNECTED) {
    Serial.printf("# Connected. In the app, type: %s:%u\n", WiFi.localIP().toString().c_str(), PUERTO_TCP);
  } else {
    Serial.println("# Could not join the WiFi. Check the network name and password. USB still works.");
  }
#endif
  servidor.begin();
  servidor.setNoDelay(true);   // send each line immediately (no Nagle buffering)
}

void setup() {
  Serial.begin(115200);
  delay(1500);                 // give the USB serial port time to come up
  Serial.println("# Jackson Five | ESP32 ready for Kayena (USB + WiFi)");
  arrancarWiFi();
#if USAR_SENSOR
  dht.begin();
#endif
}

void loop() {
  atenderClientes();           // accept new app connections
  revisarModoPrueba();         // handle values typed in the Serial Monitor

#if USAR_SENSOR
  // Non-blocking timer: read the sensor every PERIODO_MS
  if (millis() - ultimo < PERIODO_MS) return;
  ultimo = millis();

  float t = dht.readTemperature();
  float h = dht.readHumidity();
  if (isnan(t) || isnan(h)) {
    // Failed read: report it (every 5th failure, to avoid flooding) and skip.
    // No value is ever made up.
    errores_seguidos++;
    if (errores_seguidos % 5 == 1) {
      mandarLinea("# READ_ERROR from the DHT11 (check wiring: data to GPIO 4, 3.3 V and GND). No value is made up.");
    }
    return;
  }
  errores_seguidos = 0;

  // Store in the 30 s ring buffer used by the GMM
  hist_t[posicion] = t;
  hist_h[posicion] = h;
  posicion = (posicion + 1) % N_PROMEDIO_GMM;
  if (guardadas < N_PROMEDIO_GMM) guardadas++;

  // Accumulate the 10 s average and send it when complete
  suma_t += t; suma_h += h; en_envio++;
  if (en_envio >= LECTURAS_POR_ENVIO) {
    mandarJSON(suma_t / en_envio, suma_h / en_envio, nullptr);
    suma_t = 0; suma_h = 0; en_envio = 0;
  }
#endif
}
