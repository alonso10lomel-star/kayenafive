/*
  Jackson_App_ESP32.ino  |  Jackson Five - NASA Space Apps 2026
  USB firmware for the Kayena crop-rotation assistant (Kayena.exe).

  WHAT IT DOES
    1. Reads AIR temperature and humidity from a DHT11 sensor every 2 seconds.
    2. Every 10 seconds it sends ONE line over USB with the average of those reads:
         {"t":24.3,"h":31.0,"g":1,"p":[0.12,0.85,0.03]}
       t = temperature (°C), averaged over the last 10 s
       h = relative humidity (%), averaged over the last 10 s
       g = index of the most likely GMM group (season)
       p = probability of each GMM group, in the order defined in gmm_modelo.h
       An optional "f":"manual" field marks values typed in test mode.
    3. The GMM runs HERE, inside the ESP32 (TinyML), on the 30 s average.
       The app also collects 24 hours of readings and classifies the daily
       average, which is how the model learned from NASA POWER.

  SENSOR: DHT11
    Range 0-50 °C (±2 °C) and 20-90 % RH (±5 %), at most one read per second.
    It cannot measure below 0 °C, so it cannot report how hard a frost was.

  WIRING (same as Misael's sketch)
    DHT11 data -> GPIO 4, power -> 3.3 V, ground -> GND. Serial at 115200 baud.

  REQUIRED FILES (same folder as this sketch)
    gmm_modelo.h      model parameters generated by entrenar_gmm.py
    gmm_clasificar.h  gmm_clasificar(): GMM inference (Mahalanobis + softmax)

  LIBRARIES
    "DHT sensor library" (Adafruit).

  TEST MODE (no sensor)
    Set USAR_SENSOR to 0 and type "temperature,humidity" in the Serial Monitor
    (e.g. 30,20). WARNING: close the Serial Monitor before opening the app,
    because only one program can use the USB port at a time.

  Lines starting with "#" are messages for humans; the app ignores them.
*/

#include <DHT.h>
#include "gmm_clasificar.h"

// ========================= CONFIGURATION =========================
#define USAR_SENSOR 1          // 1 = real DHT11 | 0 = Serial test mode only
#define PIN_DHT     4          // GPIO connected to the DHT11 data pin
#define TIPO_DHT    DHT11      // sensor model used by the team
const unsigned long PERIODO_MS = 2000;   // time between reads (DHT11 allows 1 s; 2 s is safe)
const int LECTURAS_POR_ENVIO = 5;        // 5 reads x 2 s = one line every 10 s
const int N_PROMEDIO_GMM = 15;           // 15 reads x 2 s = 30 s average for the GMM
// =================================================================

DHT dht(PIN_DHT, TIPO_DHT);

// Ring buffer with the last 30 s of readings (input to the GMM)
float hist_t[N_PROMEDIO_GMM], hist_h[N_PROMEDIO_GMM];
int guardadas = 0, posicion = 0;         // how many are stored / next slot to write

// Running sums for the 10 s average that is sent to the app
float suma_t = 0, suma_h = 0;
int en_envio = 0;

unsigned long ultimo = 0;                // time of the last sensor read (ms)
int errores_seguidos = 0;                // consecutive failed sensor reads

// Classifies with the GMM and prints the JSON line over USB.
//   t, h    values to report (10 s average, or values typed in test mode)
//   fuente  nullptr for sensor data, or a tag such as "manual"
void mandarJSON(float t, float h, const char* fuente) {
  float prob[GMM_N_GRUPOS];
  // The GMM uses the 30 s average once we have it; until then, the reading itself.
  float tg = t, hg = h;
  if (guardadas >= N_PROMEDIO_GMM) {
    tg = 0; hg = 0;
    for (int i = 0; i < N_PROMEDIO_GMM; i++) { tg += hist_t[i]; hg += hist_h[i]; }
    tg /= N_PROMEDIO_GMM; hg /= N_PROMEDIO_GMM;
  }
  int g = gmm_clasificar(tg, hg, prob);   // TinyML inference on the ESP32

  Serial.printf("{\"t\":%.2f,\"h\":%.1f,\"g\":%d,\"p\":[", t, h, g);
  for (int i = 0; i < GMM_N_GRUPOS; i++) {
    Serial.printf(i ? ",%.4f" : "%.4f", prob[i]);
  }
  if (fuente) Serial.printf("],\"f\":\"%s\"}\n", fuente);
  else Serial.println("]}");
}

// Test mode: reads "temperature,humidity" typed in the Serial Monitor and
// sends it as a reading tagged "manual". Works even with the sensor enabled.
void revisarModoPrueba() {
  if (!Serial.available()) return;
  String linea = Serial.readStringUntil('\n');
  linea.trim();
  int coma = linea.indexOf(',');
  if (coma < 0) {
    Serial.println("# Type it like this: temperature,humidity   (example: 30,20)");
    return;
  }
  float t = linea.substring(0, coma).toFloat();
  float h = linea.substring(coma + 1).toFloat();
  mandarJSON(t, h, "manual");
}

void setup() {
  Serial.begin(115200);
  delay(1500);                 // give the USB serial port time to come up
  Serial.println("# Jackson Five | ESP32 ready for the Kayena app");
  Serial.println("# Sends {\"t\",\"h\",\"g\",\"p\"} every 10 s. Test mode: type 30,20");
#if USAR_SENSOR
  dht.begin();
#endif
}

void loop() {
  revisarModoPrueba();         // handle values typed in the Serial Monitor

#if USAR_SENSOR
  // Non-blocking timer: read the sensor every PERIODO_MS
  if (millis() - ultimo < PERIODO_MS) return;
  ultimo = millis();

  float t = dht.readTemperature();
  float h = dht.readHumidity();
  if (isnan(t) || isnan(h)) {
    // Failed read: report it (every 5th failure, to avoid flooding) and skip.
    // No value is ever made up.
    errores_seguidos++;
    if (errores_seguidos % 5 == 1) {
      Serial.println("# READ_ERROR from the DHT11 (check wiring: data to GPIO 4, 3.3 V and GND). No value is made up.");
    }
    return;
  }
  errores_seguidos = 0;

  // Store in the 30 s ring buffer used by the GMM
  hist_t[posicion] = t;
  hist_h[posicion] = h;
  posicion = (posicion + 1) % N_PROMEDIO_GMM;
  if (guardadas < N_PROMEDIO_GMM) guardadas++;

  // Accumulate the 10 s average and send it when complete
  suma_t += t; suma_h += h; en_envio++;
  if (en_envio >= LECTURAS_POR_ENVIO) {
    mandarJSON(suma_t / en_envio, suma_h / en_envio, nullptr);
    suma_t = 0; suma_h = 0; en_envio = 0;
  }
#endif
}
